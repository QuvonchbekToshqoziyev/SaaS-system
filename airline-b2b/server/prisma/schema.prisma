datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  FIRM
}

enum FirmUserRole {
  FIRM_ADMIN
  MANAGER
  KASSIR
}

enum FlightSettlementStatus {
  OPEN
  CLOSING
  CLOSED
}

enum TicketStatus {
  AVAILABLE
  PENDING
  ASSIGNED
  ALLOCATED
  RESERVED_FOR_TOUR
  SOLD
  CANCELLED
  REFUNDED
  DELETED
}

enum TicketProductType {
  ROUND_TRIP
  ONE_WAY
}

enum TicketLegDirection {
  OUTBOUND
  RETURN
}

enum TicketLegStatus {
  AVAILABLE
  PENDING_ALLOCATION
  ASSIGNED
  RESERVED_FOR_TOUR
  SOLD
  CANCELLED
  RETURNED
  DELETED
}

enum FirmStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FirmKind {
  AGENCY
  AIRLINE
  CONTRACTOR
}

enum TransactionType {
  ALLOCATION
  SALE
  PAYMENT
  REFUND
  ADJUSTMENT
  PAYABLE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  FAILED
}

enum KassaStatus {
  OPEN
  CLOSED
}

enum FinancialAccountType {
  CASH
  CARD
  BANK
  OWNER
  OTHER
}

enum ChatType {
  PERSONAL
  DEPARTMENT
  BRANCH
  COMPANY
  SUPPORT
  AI
}

enum ChatMessageKind {
  TEXT
  EMOJI
  FILE
  IMAGE
  PDF
  EXCEL
  VOICE
}

model User {
  id                              String                    @id @default(uuid())
  email                           String                    @unique
  password                        String
  fullName                        String?
  phone                           String?
  role                            Role                      @default(FIRM)
  firmRole                        FirmUserRole              @default(MANAGER)
  status                          String                    @default("ACTIVE")
  firmId                          String?
  firm                            Firm?                     @relation(fields: [firmId], references: [id])
  firmAccesses                    UserFirmAccess[]
  createdTransactions             Transaction[]             @relation("TransactionCreatedBy")
  createdKassaDesks               KassaDesk[]               @relation("KassaDeskCreatedBy")
  assignedKassaDesks              KassaDesk[]               @relation("KassaDeskCashier")
  createdSaleCancellationRequests SaleCancellationRequest[] @relation("SaleCancellationRequestCreatedBy")
  decidedSaleCancellationRequests SaleCancellationRequest[] @relation("SaleCancellationRequestDecidedBy")
  openedKassaDays                 KassaDay[]                @relation("KassaOpenedBy")
  closedKassaDays                 KassaDay[]                @relation("KassaClosedBy")
  createdPaymentCards             PaymentCard[]             @relation("PaymentCardCreatedBy")
  chatParticipants                ChatParticipant[]
  sentChatMessages                ChatMessage[]             @relation("ChatMessageSender")
  createdServiceOfferings         ServiceOffering[]         @relation("ServiceOfferingCreator")
  createdTourPackages             TourPackage[]             @relation("TourPackageCreator")
  deletedTourPackages             TourPackage[]             @relation("TourPackageDeletedBy")
  auditLogs                       AuditLog[]                @relation("AuditLogActor")
  notifications                   Notification[]            @relation("NotificationUser")
  telegramChatId                  String?                   @unique
  telegramUsername                String?
  telegramNotificationsEnabled    Boolean                   @default(true)
  telegramLinkedAt                DateTime?
  telegramLinkTokenHash           String?                   @unique
  telegramLinkExpiresAt           DateTime?
  telegramDeliveries              TelegramDelivery[]
  createdCurrencyRates            CurrencyRate[]            @relation("CurrencyRateCreatedBy")
  createdTicketSales              TicketSale[]              @relation("TicketSaleCreatedBy")
  deletedAt                       DateTime?
  deletedByUserId                 String?
  deleteReason                    String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt

  @@index([status])
  @@index([firmRole])
  @@index([deletedAt])
}

model Firm {
  id                        String                    @id @default(uuid())
  name                      String
  contactFullName           String?
  phone                     String?
  subscriptionEndsAt        DateTime?
  creditLimit               Decimal                   @default(0) @db.Decimal(18, 4)
  currency                  String                    @default("USD")
  kind                      FirmKind                  @default(AGENCY)
  status                    FirmStatus                @default(ACTIVE)
  deletedAt                 DateTime?
  deletedByUserId           String?
  deleteReason              String?
  createdByUserId           String?
  createdByFirmId           String?
  createdByRole             String?
  users                     User[]
  userAccesses              UserFirmAccess[]
  employees                 Employee[]
  tickets                   Ticket[]                  @relation("TicketAssignedFirm")
  originalTickets           Ticket[]                  @relation("TicketOriginalOwnerFirm")
  ownedTicketLegs           TicketLeg[]               @relation("TicketLegCurrentOwnerFirm")
  allocationSourceTickets   Ticket[]                  @relation("TicketAllocationSourceFirm")
  sentTicketAllocations     TicketAllocation[]        @relation("TicketAllocationSender")
  receivedTicketAllocations TicketAllocation[]        @relation("TicketAllocationReceiver")
  ownedFlights              Flight[]                  @relation("FlightOwnerFirm")
  transactions              Transaction[]
  kassaDesks                KassaDesk[]
  paidTransactions          Transaction[]             @relation("TransactionPayerFirm")
  receivedTransactions      Transaction[]             @relation("TransactionReceiverFirm")
  payments                  Payment[]
  paymentCards              PaymentCard[]
  paymentAllocations        PaymentAllocation[]
  currencyRates             CurrencyRate[]
  financialAccounts         FinancialAccount[]
  financialThresholds       FinancialThreshold[]
  overheadAllocationRules   OverheadAllocationRule[]
  invitations               Invitation[]
  saleCancellationRequests  SaleCancellationRequest[]
  ticketSales               TicketSale[]              @relation("TicketSaleSellerFirm")
  ownedTourPackages         TourPackage[]             @relation("TourPackageOwner")
  boughtTourPackageSales    TourPackageSale[]         @relation("TourPackageBuyer")
  soldTourPackageSales      TourPackageSale[]         @relation("TourPackageSeller")
  ownedServiceOfferings     ServiceOffering[]         @relation("ServiceOfferingOwner")
  suppliedServiceOfferings  ServiceOffering[]         @relation("ServiceOfferingProvider")
  providedServices          ServiceAssignment[]       @relation("ServiceProviderFirm")
  receivedServices          ServiceAssignment[]       @relation("ServiceRecipientFirm")
  chatConversations         ChatConversation[]
  airlineProfiles           Airline[]
  notifications             Notification[]
  airlineConnections        AirlineFirmConnection[]   @relation("AirlineConnectionAirline")
  firmAirlineConnections    AirlineFirmConnection[]   @relation("AirlineConnectionFirm")
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([kind])
  @@index([createdByUserId])
  @@index([createdByFirmId])
  @@index([status])
  @@index([deletedAt])
}

model Notification {
  id                 String             @id @default(uuid())
  firmId             String?
  firm               Firm?              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?              @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  title              String
  body               String
  type               String             @default("INFO")
  entityType         String?
  entityId           String?
  metadata           Json?
  readAt             DateTime?
  createdAt          DateTime           @default(now())
  telegramDeliveries TelegramDelivery[]

  @@index([firmId, readAt, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model TelegramDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId         String
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId])
  @@index([status, createdAt])
}

model AirlineFirmConnection {
  id              String   @id @default(uuid())
  airlineFirmId   String
  airlineFirm     Firm     @relation("AirlineConnectionAirline", fields: [airlineFirmId], references: [id], onDelete: Cascade)
  firmId          String
  firm            Firm     @relation("AirlineConnectionFirm", fields: [firmId], references: [id], onDelete: Cascade)
  status          String   @default("ACTIVE")
  createdByUserId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([airlineFirmId, firmId])
  @@index([airlineFirmId, status])
  @@index([firmId, status])
}

model UserFirmAccess {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, firmId])
  @@index([userId])
  @@index([firmId])
}

model Employee {
  id              String     @id @default(uuid())
  name            String
  role            String
  salary          Decimal    @default(0) @db.Decimal(18, 4)
  currency        String     @default("UZS")
  firmId          String?
  firm            Firm?      @relation(fields: [firmId], references: [id])
  status          FirmStatus @default(ACTIVE)
  deletedAt       DateTime?
  deletedByUserId String?
  deleteReason    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([firmId])
  @@index([status])
  @@index([deletedAt])
}

model ChatConversation {
  id           String            @id @default(uuid())
  type         ChatType
  title        String
  description  String?
  department   String?
  branchName   String?
  firmId       String?
  firm         Firm?             @relation(fields: [firmId], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type])
  @@index([firmId])
  @@index([updatedAt])
}

model ChatParticipant {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  mutedAt        DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id               String           @id @default(uuid())
  conversationId   String
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId     String?
  sender           User?            @relation("ChatMessageSender", fields: [senderUserId], references: [id])
  kind             ChatMessageKind  @default(TEXT)
  content          String?
  attachment       Json?
  mentions         String[]         @default([])
  replyToMessageId String?
  replyToMessage   ChatMessage?     @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id])
  replies          ChatMessage[]    @relation("ChatMessageReplies")
  forwardedFromId  String?
  forwardedFrom    ChatMessage?     @relation("ChatMessageForwards", fields: [forwardedFromId], references: [id])
  forwards         ChatMessage[]    @relation("ChatMessageForwards")
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([replyToMessageId])
  @@index([forwardedFromId])
}

model ChatFirmPermission {
  id              String   @id @default(uuid())
  firmAId         String
  firmBId         String
  enabled         Boolean  @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([firmAId, firmBId])
  @@index([enabled])
  @@index([firmAId])
  @@index([firmBId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Invitation {
  id                 String       @id @default(uuid())
  email              String
  fullName           String?
  phone              String?
  firmId             String?
  firm               Firm?        @relation(fields: [firmId], references: [id])
  role               Role         @default(FIRM)
  firmRole           FirmUserRole @default(MANAGER)
  token              String       @unique
  expiresAt          DateTime
  subscriptionEndsAt DateTime?
  usedAt             DateTime?
  deletedAt          DateTime?
  deletedByUserId    String?
  deleteReason       String?
  createdBy          String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([firmId])
  @@index([createdBy])
  @@index([expiresAt])
  @@index([usedAt])
}

model Flight {
  id                       String                    @id @default(uuid())
  route                    String
  flightNumber             String
  airlineId                String?
  airline                  Airline?                  @relation(fields: [airlineId], references: [id])
  ownerFirmId              String?
  ownerFirm                Firm?                     @relation("FlightOwnerFirm", fields: [ownerFirmId], references: [id], onDelete: Restrict)
  departure                DateTime                  @map("departureTime")
  arrival                  DateTime?                 @map("arrivalTime")
  tripType                 TicketProductType         @default(ONE_WAY)
  outboundOrigin           String?
  outboundDestination      String?
  returnOrigin             String?
  returnDestination        String?
  returnDeparture          DateTime?
  returnArrival            DateTime?
  currency                 String
  settlementStatus         FlightSettlementStatus    @default(OPEN)
  status                   String?
  deletedAt                DateTime?
  deletedByUserId          String?
  deleteReason             String?
  tickets                  Ticket[]
  ticketAllocations        TicketAllocation[]
  tourPackages             TourPackage[]
  serviceOfferings         ServiceOffering[]
  transactions             Transaction[]
  saleCancellationRequests SaleCancellationRequest[]
  ticketSales              TicketSale[]
  ticketLegMigrationIssues TicketLegMigrationIssue[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  ticketLegs               TicketLeg[]

  @@index([airlineId])
  @@index([ownerFirmId])
}

model Airline {
  id        String    @id @default(uuid())
  name      String
  code      String?
  firmId    String?
  firm      Firm?     @relation(fields: [firmId], references: [id])
  status    String    @default("ACTIVE")
  deletedAt DateTime?
  flights   Flight[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name])
  @@index([firmId])
  @@index([status])
  @@index([deletedAt])
}

model Ticket {
  id                       String                    @id @default(uuid())
  flightId                 String
  flight                   Flight                    @relation(fields: [flightId], references: [id])
  status                   TicketStatus              @default(AVAILABLE)
  ticketType               TicketProductType         @default(ONE_WAY)
  basePrice                Decimal                   @map("price") @db.Decimal(18, 4)
  originPrice              Decimal                   @default(0) @db.Decimal(18, 4)
  currency                 String
  assignedFirmId           String?                   @map("allocatedFirmId")
  assignedFirm             Firm?                     @relation("TicketAssignedFirm", fields: [assignedFirmId], references: [id])
  originalOwnerFirmId      String?
  originalOwnerFirm        Firm?                     @relation("TicketOriginalOwnerFirm", fields: [originalOwnerFirmId], references: [id], onDelete: Restrict)
  allocationSourceFirmId   String?
  allocationSourceFirm     Firm?                     @relation("TicketAllocationSourceFirm", fields: [allocationSourceFirmId], references: [id], onDelete: Restrict)
  allocationSourcePrice    Decimal?                  @db.Decimal(18, 4)
  allocationId             String?
  allocation               TicketAllocation?         @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  tourPackageId            String?
  tourPackage              TourPackage?              @relation(fields: [tourPackageId], references: [id], onDelete: Restrict)
  soldPrice                Decimal?                  @db.Decimal(18, 4)
  soldCurrency             String?
  purchaserInfo            Json?
  deletedAt                DateTime?
  deletedByUserId          String?
  deleteReason             String?
  saleCancellationRequests SaleCancellationRequest[]
  transactions             Transaction[]
  legs                     TicketLeg[]
  migrationIssues          TicketLegMigrationIssue[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([flightId, status])
  @@index([assignedFirmId, status])
  @@index([originalOwnerFirmId, status])
  @@index([allocationSourceFirmId, status])
  @@index([allocationId, status])
  @@index([flightId, assignedFirmId])
  @@index([tourPackageId, status])
  @@index([deletedAt])
}

model TicketLeg {
  id                      String                @id @default(uuid())
  ticketId                String
  ticket                  Ticket                @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  flightId                String
  flight                  Flight                @relation(fields: [flightId], references: [id], onDelete: Restrict)
  direction               TicketLegDirection
  origin                  String
  destination             String
  departureAt             DateTime?
  arrivalAt               DateTime?
  status                  TicketLegStatus       @default(AVAILABLE)
  currentOwnerFirmId      String?
  currentOwnerFirm        Firm?                 @relation("TicketLegCurrentOwnerFirm", fields: [currentOwnerFirmId], references: [id], onDelete: Restrict)
  pendingAllocationId     String?
  pendingAllocation       TicketAllocation?     @relation("PendingAllocationLegs", fields: [pendingAllocationId], references: [id], onDelete: SetNull)
  acceptedAllocationId    String?
  acceptedAllocation      TicketAllocation?     @relation("AcceptedAllocationLegs", fields: [acceptedAllocationId], references: [id], onDelete: SetNull)
  tourPackageId           String?
  tourPackage             TourPackage?          @relation(fields: [tourPackageId], references: [id], onDelete: Restrict)
  acquisitionCostSnapshot Decimal               @db.Decimal(18, 4)
  originalCostSnapshot    Decimal               @db.Decimal(18, 4)
  allocationPriceSnapshot Decimal?              @db.Decimal(18, 4)
  currencySnapshot        String
  allocationItems         TicketAllocationLeg[]
  saleItems               TicketSaleItem[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([ticketId, direction])
  @@index([flightId, currentOwnerFirmId, status, direction])
  @@index([pendingAllocationId, status])
  @@index([acceptedAllocationId, status])
  @@index([tourPackageId, status])
}

model TicketAllocation {
  id                String                     @id @default(uuid())
  flightId          String
  flight            Flight                     @relation(fields: [flightId], references: [id], onDelete: Restrict)
  fromFirmId        String
  fromFirm          Firm                       @relation("TicketAllocationSender", fields: [fromFirmId], references: [id], onDelete: Restrict)
  toFirmId          String
  toFirm            Firm                       @relation("TicketAllocationReceiver", fields: [toFirmId], references: [id], onDelete: Restrict)
  status            String                     @default("PENDING")
  currency          String
  totalAmount       Decimal                    @db.Decimal(18, 4)
  note              String?
  createdByUserId   String?
  acceptedAt        DateTime?
  acceptedByUserId  String?
  rejectionReason   String?
  rejectedAt        DateTime?
  rejectedByUserId  String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  version           Int                        @default(1)
  productType       TicketProductType          @default(ROUND_TRIP)
  direction         TicketLegDirection?
  parentTicketCount Int                        @default(0)
  segmentCount      Int                        @default(0)
  tickets           Ticket[]
  priceRows         TicketAllocationPriceRow[]
  legItems          TicketAllocationLeg[]
  pendingLegs       TicketLeg[]                @relation("PendingAllocationLegs")
  acceptedLegs      TicketLeg[]                @relation("AcceptedAllocationLegs")
  changeRequests    AllocationChangeRequest[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([flightId, status])
  @@index([fromFirmId, status])
  @@index([toFirmId, status])
  @@index([createdAt])
}

model AllocationChangeRequest {
  id                           String           @id @default(uuid())
  allocationId                 String
  allocation                   TicketAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  requestedByFirmId            String
  requestedByUserId            String?
  receivingFirmId              String
  type                         String
  oldValuesJson                Json
  proposedValuesJson           Json
  reason                       String
  status                       String           @default("PENDING_APPROVAL")
  requiresCounterpartyApproval Boolean          @default(true)
  autoApproved                 Boolean          @default(false)
  baseVersion                  Int
  approvedByUserId             String?
  rejectedByUserId             String?
  rejectionReason              String?
  approvedAt                   DateTime?
  rejectedAt                   DateTime?
  appliedAt                    DateTime?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([allocationId, status])
  @@index([requestedByFirmId, status])
  @@index([receivingFirmId, status])
  @@index([createdAt])
}

model TicketAllocationPriceRow {
  id           String              @id @default(uuid())
  allocationId String
  allocation   TicketAllocation    @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  quantity     Int
  unitPrice    Decimal             @db.Decimal(18, 4)
  position     Int                 @default(0)
  productType  TicketProductType   @default(ROUND_TRIP)
  direction    TicketLegDirection?
  currency     String              @default("UZS")
  totalAmount  Decimal             @default(0) @db.Decimal(18, 4)

  @@index([allocationId, position])
}

model TicketAllocationLeg {
  id                          String             @id @default(uuid())
  allocationId                String
  allocation                  TicketAllocation   @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  ticketLegId                 String
  ticketLeg                   TicketLeg          @relation(fields: [ticketLegId], references: [id], onDelete: Restrict)
  productType                 TicketProductType
  direction                   TicketLegDirection
  previousOwnerFirmId         String?
  previousStatus              TicketLegStatus
  acquisitionCostSnapshot     Decimal            @db.Decimal(18, 4)
  allocationPriceSnapshot     Decimal            @db.Decimal(18, 4)
  productUnitPriceSnapshot    Decimal            @db.Decimal(18, 4)
  currencySnapshot            String
  acquisitionCurrencySnapshot String
  allocationCurrencySnapshot  String
  status                      String             @default("ACTIVE")
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@unique([allocationId, ticketLegId])
  @@index([ticketLegId, status])
  @@index([allocationId, status])
}

model TicketSale {
  id                   String                    @id @default(uuid())
  flightId             String
  flight               Flight                    @relation(fields: [flightId], references: [id], onDelete: Restrict)
  sellerFirmId         String
  sellerFirm           Firm                      @relation("TicketSaleSellerFirm", fields: [sellerFirmId], references: [id], onDelete: Restrict)
  productType          TicketProductType
  direction            TicketLegDirection?
  quantity             Int
  segmentCount         Int
  unitPrice            Decimal                   @db.Decimal(18, 4)
  currency             String
  totalAmount          Decimal                   @db.Decimal(18, 4)
  purchaserInfo        Json
  status               String                    @default("CONFIRMED")
  transactionId        String?                   @unique
  transaction          Transaction?              @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdByUserId      String?
  createdBy            User?                     @relation("TicketSaleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items                TicketSaleItem[]
  cancellationRequests SaleCancellationRequest[]
  cancelledAt          DateTime?
  cancelledByUserId    String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([flightId, sellerFirmId, status])
  @@index([createdAt])
}

model TicketSaleItem {
  id                          String     @id @default(uuid())
  saleId                      String
  sale                        TicketSale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  ticketLegId                 String
  ticketLeg                   TicketLeg  @relation(fields: [ticketLegId], references: [id], onDelete: Restrict)
  acquisitionCostSnapshot     Decimal    @db.Decimal(18, 4)
  salePriceSnapshot           Decimal    @db.Decimal(18, 4)
  currencySnapshot            String
  acquisitionCurrencySnapshot String
  saleCurrencySnapshot        String
  status                      String     @default("CONFIRMED")
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  @@unique([saleId, ticketLegId])
  @@index([ticketLegId, status])
}

model TicketLegMigrationIssue {
  id         String    @id @default(uuid())
  flightId   String
  flight     Flight    @relation(fields: [flightId], references: [id], onDelete: Restrict)
  ticketId   String?
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  code       String
  details    Json
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([flightId, code])
  @@index([ticketId])
}

model CurrencyRate {
  id              String   @id @default(uuid())
  firmId          String?
  firm            Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  baseCurrency    String
  targetCurrency  String
  rate            Decimal  @db.Decimal(12, 6)
  source          String
  recordedAt      DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation("CurrencyRateCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([firmId, targetCurrency, recordedAt])
  @@index([firmId, targetCurrency, recordedAt])
}

model SiteContent {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id                    String              @id @default(uuid())
  type                  TransactionType
  firmId                String
  firm                  Firm                @relation(fields: [firmId], references: [id])
  kassaDeskId           String?
  kassaDesk             KassaDesk?          @relation(fields: [kassaDeskId], references: [id], onDelete: SetNull)
  flightId              String?
  flight                Flight?             @relation(fields: [flightId], references: [id])
  ticketId              String?
  ticket                Ticket?             @relation(fields: [ticketId], references: [id])
  payerFirmId           String?
  payerFirm             Firm?               @relation("TransactionPayerFirm", fields: [payerFirmId], references: [id])
  receiverFirmId        String?
  receiverFirm          Firm?               @relation("TransactionReceiverFirm", fields: [receiverFirmId], references: [id])
  direction             String?
  subjectType           String?
  subjectId             String?
  createdByUserId       String?
  createdBy             User?               @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id])
  originalAmount        Decimal             @db.Decimal(18, 4)
  currency              String
  exchangeRate          Decimal             @db.Decimal(12, 6)
  baseAmount            Decimal             @db.Decimal(18, 4)
  paymentMethod         String?
  paymentCardId         String?
  paymentCard           PaymentCard?        @relation(fields: [paymentCardId], references: [id])
  sourceAccountId       String?
  sourceAccount         FinancialAccount?   @relation("TransactionSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  destinationAccountId  String?
  destinationAccount    FinancialAccount?   @relation("TransactionDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  idempotencyKey        String?             @unique
  metadata              Json?
  sourceMode            String              @default("MANUAL_BANK")
  status                String              @default("CONFIRMED")
  reversedTransactionId String?
  deletedAt             DateTime?
  ledgerEntries         LedgerEntry[]
  paymentAllocations    PaymentAllocation[]
  tourPackageSale       TourPackageSale?
  serviceOffering       ServiceOffering?
  ticketSale            TicketSale?
  createdAt             DateTime            @default(now())

  @@index([firmId, createdAt])
  @@index([kassaDeskId, createdAt])
  @@index([payerFirmId, createdAt])
  @@index([receiverFirmId, createdAt])
  @@index([flightId, createdAt])
  @@index([subjectType, subjectId])
  @@index([type, createdAt])
  @@index([currency, createdAt])
  @@index([paymentMethod, createdAt])
  @@index([paymentCardId, createdAt])
  @@index([sourceAccountId, createdAt])
  @@index([destinationAccountId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([sourceMode, status, createdAt])
  @@index([reversedTransactionId])
  @@index([deletedAt])
}

model FinancialAccount {
  id                      String               @id @default(uuid())
  firmId                  String
  firm                    Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name                    String
  type                    FinancialAccountType
  currency                String
  openingBalance          Decimal              @default(0) @db.Decimal(18, 4)
  kassaDeskId             String?
  paymentCardId           String?
  status                  String               @default("ACTIVE")
  sourceTransactions      Transaction[]        @relation("TransactionSourceAccount")
  destinationTransactions Transaction[]        @relation("TransactionDestinationAccount")
  createdByUserId         String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([firmId, name, currency])
  @@unique([kassaDeskId, currency])
  @@unique([paymentCardId, currency])
  @@index([firmId, type, status])
}

model PaymentAllocation {
  id              String      @id @default(uuid())
  companyId       String      @map("company_id")
  company         Firm        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentId       String      @map("payment_id")
  payment         Transaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  documentType    String      @map("document_type")
  documentId      String      @map("document_id")
  allocatedAmount Decimal     @map("allocated_amount") @db.Decimal(18, 4)
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([companyId])
  @@index([paymentId])
  @@index([documentType, documentId])
  @@map("payment_allocations")
}

model FinancialThreshold {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  company    Firm     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metricCode String   @map("metric_code")
  greenMin   Decimal? @map("green_min") @db.Decimal(18, 4)
  yellowMin  Decimal? @map("yellow_min") @db.Decimal(18, 4)
  redMax     Decimal? @map("red_max") @db.Decimal(18, 4)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([companyId, metricCode])
  @@index([companyId])
  @@map("financial_thresholds")
}

model OverheadAllocationRule {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  company       Firm      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  method        String    @default("BY_REVENUE")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([companyId, active])
  @@index([effectiveFrom, effectiveTo])
  @@map("overhead_allocation_rules")
}

model PaymentCard {
  id              String        @id @default(uuid())
  ownerName       String
  cardNumber      String
  currency        String        @default("UZS")
  openingBalance  Decimal       @default(0) @db.Decimal(18, 4)
  firmId          String?
  firm            Firm?         @relation(fields: [firmId], references: [id])
  cashDeskId      String?
  status          String        @default("ACTIVE")
  deletedAt       DateTime?
  deletedByUserId String?
  deleteReason    String?
  createdByUserId String?
  createdBy       User?         @relation("PaymentCardCreatedBy", fields: [createdByUserId], references: [id])
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model KassaDesk {
  id                    String        @id @default(uuid())
  firmId                String
  firm                  Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name                  String
  code                  String?
  status                String        @default("ACTIVE")
  deletedAt             DateTime?
  deletedByUserId       String?
  deleteReason          String?
  createdByUserId       String?
  createdBy             User?         @relation("KassaDeskCreatedBy", fields: [createdByUserId], references: [id])
  assignedCashierUserId String?
  assignedCashier       User?         @relation("KassaDeskCashier", fields: [assignedCashierUserId], references: [id], onDelete: SetNull)
  transactions          Transaction[]
  kassaDays             KassaDay[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([id, firmId])
  @@index([firmId, status])
  @@index([firmId, createdAt])
  @@index([firmId, name])
  @@index([assignedCashierUserId, status])
  @@index([deletedAt])
}

model TourPackage {
  id                 String              @id @default(uuid())
  ownerFirmId        String
  ownerFirm          Firm                @relation("TourPackageOwner", fields: [ownerFirmId], references: [id])
  flightId           String?
  flight             Flight?             @relation(fields: [flightId], references: [id])
  name               String
  destination        String
  startDate          DateTime?
  endDate            DateTime?
  quantity           Int
  availableQuantity  Int
  soldQuantity       Int                 @default(0)
  ticketsPerTour     Int                 @default(1)
  ticketProductType  TicketProductType   @default(ROUND_TRIP)
  ticketDirection    TicketLegDirection?
  unitPrice          Decimal             @db.Decimal(18, 4)
  ticketPrice        Decimal             @default(0) @db.Decimal(18, 4)
  servicePrice       Decimal             @default(0) @db.Decimal(18, 4)
  totalCost          Decimal             @default(0) @db.Decimal(18, 4)
  currency           String              @default("UZS")
  status             String              @default("ACTIVE")
  deletedAt          DateTime?
  deletedByUserId    String?
  deletedBy          User?               @relation("TourPackageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deleteReason       String?
  notes              String?
  createdByUserId    String?
  createdBy          User?               @relation("TourPackageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  components         TourComponent[]
  reservedTickets    Ticket[]
  reservedTicketLegs TicketLeg[]
  sales              TourPackageSale[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([ownerFirmId, status])
  @@index([flightId, status])
  @@index([destination])
  @@index([deletedAt])
}

model TourComponent {
  id                    String              @id @default(uuid())
  tourId                String
  tour                  TourPackage         @relation(fields: [tourId], references: [id], onDelete: Restrict)
  componentType         String
  ticketProductType     TicketProductType?
  ticketDirection       TicketLegDirection?
  segmentCount          Int                 @default(0)
  serviceId             String?
  service               ServiceOffering?    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  quantityPerTour       Int
  totalReservedQuantity Int
  consumedQuantity      Int                 @default(0)
  unitCostSnapshot      Decimal             @db.Decimal(18, 4)
  originalCurrency      String
  currencySnapshot      String
  exchangeRateSnapshot  Decimal             @db.Decimal(18, 8)
  costPerTourSnapshot   Decimal             @db.Decimal(18, 4)
  totalCostSnapshot     Decimal             @db.Decimal(18, 4)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([tourId, serviceId])
  @@index([tourId, componentType])
  @@index([serviceId])
}

model TourPackageSale {
  id            String       @id @default(uuid())
  packageId     String
  package       TourPackage  @relation(fields: [packageId], references: [id])
  sellerFirmId  String
  sellerFirm    Firm         @relation("TourPackageSeller", fields: [sellerFirmId], references: [id])
  buyerFirmId   String
  buyerFirm     Firm         @relation("TourPackageBuyer", fields: [buyerFirmId], references: [id])
  quantity      Int
  unitPrice     Decimal      @db.Decimal(18, 4)
  currency      String
  totalAmount   Decimal      @db.Decimal(18, 4)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([packageId, createdAt])
  @@index([sellerFirmId, createdAt])
  @@index([buyerFirmId, createdAt])
}

model ServiceOffering {
  id                String              @id @default(uuid())
  ownerFirmId       String
  ownerFirm         Firm                @relation("ServiceOfferingOwner", fields: [ownerFirmId], references: [id])
  providerFirmId    String?
  providerFirm      Firm?               @relation("ServiceOfferingProvider", fields: [providerFirmId], references: [id])
  providerName      String?
  createdByUserId   String?
  createdByUser     User?               @relation("ServiceOfferingCreator", fields: [createdByUserId], references: [id])
  flightId          String?
  flight            Flight?             @relation(fields: [flightId], references: [id])
  name              String
  description       String?
  quantity          Int
  availableQuantity Int
  reservedQuantity  Int                 @default(0)
  consumedQuantity  Int                 @default(0)
  unitPrice         Decimal             @db.Decimal(18, 4)
  currency          String              @default("UZS")
  paymentStatus     String              @default("DEBT")
  transactionId     String?             @unique
  transaction       Transaction?        @relation(fields: [transactionId], references: [id])
  status            String              @default("ACTIVE")
  assignments       ServiceAssignment[]
  tourComponents    TourComponent[]
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([ownerFirmId, status])
  @@index([providerFirmId, status])
  @@index([flightId, status])
  @@index([deletedAt])
}

model ServiceAssignment {
  id              String          @id @default(uuid())
  offeringId      String
  offering        ServiceOffering @relation(fields: [offeringId], references: [id])
  providerFirmId  String
  providerFirm    Firm            @relation("ServiceProviderFirm", fields: [providerFirmId], references: [id])
  recipientFirmId String
  recipientFirm   Firm            @relation("ServiceRecipientFirm", fields: [recipientFirmId], references: [id])
  quantity        Int
  unitPrice       Decimal         @db.Decimal(18, 4)
  totalAmount     Decimal         @db.Decimal(18, 4)
  currency        String
  status          String          @default("ASSIGNED")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([offeringId, createdAt])
  @@index([providerFirmId, createdAt])
  @@index([recipientFirmId, createdAt])
}

model LedgerEntry {
  id                   String      @id @default(uuid())
  transactionId        String
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  debitAccount         String
  creditAccount        String
  amount               Decimal     @db.Decimal(18, 4)
  currency             String
  exchangeRateSnapshot Decimal     @db.Decimal(12, 6)
  createdAt            DateTime    @default(now())

  @@index([transactionId])
  @@index([debitAccount])
  @@index([creditAccount])
  @@index([createdAt])
}

model Payment {
  id                   String               @id @default(uuid())
  firmId               String
  firm                 Firm                 @relation(fields: [firmId], references: [id])
  amount               Decimal              @db.Decimal(18, 4)
  method               PaymentMethod
  reference            String?
  status               PaymentStatus        @default(PENDING)
  reconciliationStatus ReconciliationStatus @default(PENDING)
  createdAt            DateTime             @default(now())

  @@index([firmId, status])
  @@index([reconciliationStatus])
  @@index([createdAt])
}

model KassaDay {
  id                      String      @id @default(uuid())
  firmId                  String
  cashDeskId              String
  cashDesk                KassaDesk   @relation(fields: [cashDeskId, firmId], references: [id, firmId], onDelete: Restrict)
  activeSessionKey        String?     @unique
  currency                String      @default("UZS")
  previousSessionId       String?     @unique
  previousSession         KassaDay?   @relation("KassaSessionChain", fields: [previousSessionId], references: [id], onDelete: SetNull)
  nextSession             KassaDay?   @relation("KassaSessionChain")
  businessDate            DateTime    @db.Date
  status                  KassaStatus @default(OPEN)
  openedAt                DateTime    @default(now())
  openedByUserId          String
  openedBy                User        @relation("KassaOpenedBy", fields: [openedByUserId], references: [id])
  closedAt                DateTime?
  closedByUserId          String?
  closedBy                User?       @relation("KassaClosedBy", fields: [closedByUserId], references: [id])
  openingBalance          Decimal     @default(0) @db.Decimal(18, 4)
  openingBalanceUsd       Decimal     @default(0) @db.Decimal(18, 4)
  closingBalance          Decimal?    @db.Decimal(18, 4)
  closingBalanceUsd       Decimal?    @db.Decimal(18, 4)
  actualClosingBalance    Decimal?    @db.Decimal(18, 4)
  actualClosingBalanceUsd Decimal?    @db.Decimal(18, 4)
  expectedCash            Decimal?    @db.Decimal(18, 4)
  expectedCashUsd         Decimal?    @db.Decimal(18, 4)
  variance                Decimal?    @db.Decimal(18, 4)
  varianceUsd             Decimal?    @db.Decimal(18, 4)
  openingAdjustmentReason String?
  notes                   String?

  @@unique([businessDate, cashDeskId])
  @@index([cashDeskId, status, closedAt])
  @@index([firmId, cashDeskId, currency, status, closedAt])
  @@index([status])
  @@index([businessDate, status])
}

model SaleCancellationRequest {
  id              String      @id @default(uuid())
  flightId        String
  flight          Flight      @relation(fields: [flightId], references: [id])
  ticketId        String
  ticket          Ticket      @relation(fields: [ticketId], references: [id])
  ticketSaleId    String?
  ticketSale      TicketSale? @relation(fields: [ticketSaleId], references: [id], onDelete: Restrict)
  firmId          String
  firm            Firm        @relation(fields: [firmId], references: [id])
  status          String      @default("PENDING")
  reason          String
  decisionReason  String?
  createdByUserId String
  createdBy       User        @relation("SaleCancellationRequestCreatedBy", fields: [createdByUserId], references: [id])
  decidedByUserId String?
  decidedBy       User?       @relation("SaleCancellationRequestDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([flightId, status])
  @@index([ticketId, status])
  @@index([ticketSaleId, status])
  @@index([firmId, status])
  @@index([createdByUserId])
  @@index([decidedByUserId])
}
