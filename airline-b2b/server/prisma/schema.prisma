datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  FIRM
}

enum FirmUserRole {
  FIRM_ADMIN
  MANAGER
  KASSIR
}

enum FlightSettlementStatus {
  OPEN
  CLOSING
  CLOSED
}

enum TicketStatus {
  AVAILABLE
  PENDING
  ASSIGNED
  ALLOCATED
  SOLD
  CANCELLED
  REFUNDED
  DELETED
}

enum FirmStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FirmKind {
  AGENCY
  AIRLINE
  CONTRACTOR
}

enum TransactionType {
  ALLOCATION
  SALE
  PAYMENT
  REFUND
  ADJUSTMENT
  PAYABLE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  FAILED
}

enum KassaStatus {
  OPEN
  CLOSED
}

enum ChatType {
  PERSONAL
  DEPARTMENT
  BRANCH
  COMPANY
  SUPPORT
  AI
}

enum ChatMessageKind {
  TEXT
  EMOJI
  FILE
  IMAGE
  PDF
  EXCEL
  VOICE
}

model User {
  id                              String                    @id @default(uuid())
  email                           String                    @unique
  password                        String
  fullName                        String?
  phone                           String?
  role                            Role                      @default(FIRM)
  firmRole                        FirmUserRole              @default(FIRM_ADMIN)
  status                          String                    @default("ACTIVE")
  firmId                          String?
  firm                            Firm?                     @relation(fields: [firmId], references: [id])
  firmAccesses                    UserFirmAccess[]
  createdTransactions             Transaction[]             @relation("TransactionCreatedBy")
  createdKassaDesks               KassaDesk[]               @relation("KassaDeskCreatedBy")
  createdSaleCancellationRequests SaleCancellationRequest[] @relation("SaleCancellationRequestCreatedBy")
  decidedSaleCancellationRequests SaleCancellationRequest[] @relation("SaleCancellationRequestDecidedBy")
  openedKassaDays                 KassaDay[]                @relation("KassaOpenedBy")
  closedKassaDays                 KassaDay[]                @relation("KassaClosedBy")
  createdPaymentCards             PaymentCard[]             @relation("PaymentCardCreatedBy")
  chatParticipants                ChatParticipant[]
  sentChatMessages                ChatMessage[]             @relation("ChatMessageSender")
  auditLogs                       AuditLog[]                @relation("AuditLogActor")
  notifications                   Notification[]            @relation("NotificationUser")
  deletedAt                       DateTime?
  deletedByUserId                 String?
  deleteReason                    String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt

  @@index([status])
  @@index([firmRole])
  @@index([deletedAt])
}

model Firm {
  id                       String                    @id @default(uuid())
  name                     String
  contactFullName          String?
  phone                    String?
  subscriptionEndsAt       DateTime?
  creditLimit              Decimal                   @default(0) @db.Decimal(12, 4)
  currency                 String                    @default("USD")
  kind                     FirmKind                  @default(AGENCY)
  status                   FirmStatus                @default(ACTIVE)
  deletedAt                DateTime?
  deletedByUserId          String?
  deleteReason             String?
  createdByUserId          String?
  createdByFirmId          String?
  createdByRole            String?
  users                    User[]
  userAccesses             UserFirmAccess[]
  employees                Employee[]
  tickets                  Ticket[]
  transactions             Transaction[]
  kassaDesks               KassaDesk[]
  paidTransactions         Transaction[]             @relation("TransactionPayerFirm")
  receivedTransactions     Transaction[]             @relation("TransactionReceiverFirm")
  payments                 Payment[]
  paymentCards             PaymentCard[]
  paymentAllocations       PaymentAllocation[]
  financialThresholds      FinancialThreshold[]
  overheadAllocationRules  OverheadAllocationRule[]
  invitations              Invitation[]
  saleCancellationRequests SaleCancellationRequest[]
  ownedTourPackages        TourPackage[]             @relation("TourPackageOwner")
  boughtTourPackageSales   TourPackageSale[]         @relation("TourPackageBuyer")
  soldTourPackageSales     TourPackageSale[]         @relation("TourPackageSeller")
  chatConversations        ChatConversation[]
  airlineProfiles          Airline[]
  notifications            Notification[]
  airlineConnections       AirlineFirmConnection[]  @relation("AirlineConnectionAirline")
  firmAirlineConnections   AirlineFirmConnection[]  @relation("AirlineConnectionFirm")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([kind])
  @@index([createdByUserId])
  @@index([createdByFirmId])
  @@index([status])
  @@index([deletedAt])
}

model Notification {
  id          String   @id @default(uuid())
  firmId      String?
  firm        Firm?    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        String   @default("INFO")
  entityType  String?
  entityId    String?
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([firmId, readAt, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model AirlineFirmConnection {
  id              String   @id @default(uuid())
  airlineFirmId   String
  airlineFirm     Firm     @relation("AirlineConnectionAirline", fields: [airlineFirmId], references: [id], onDelete: Cascade)
  firmId          String
  firm            Firm     @relation("AirlineConnectionFirm", fields: [firmId], references: [id], onDelete: Cascade)
  status          String   @default("ACTIVE")
  createdByUserId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([airlineFirmId, firmId])
  @@index([airlineFirmId, status])
  @@index([firmId, status])
}

model UserFirmAccess {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, firmId])
  @@index([userId])
  @@index([firmId])
}

model Employee {
  id        String     @id @default(uuid())
  name      String
  role      String
  salary    Decimal    @default(0) @db.Decimal(12, 4)
  currency  String     @default("UZS")
  firmId    String?
  firm      Firm?      @relation(fields: [firmId], references: [id])
  status    FirmStatus @default(ACTIVE)
  deletedAt DateTime?
  deletedByUserId String?
  deleteReason String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([firmId])
  @@index([status])
  @@index([deletedAt])
}

model ChatConversation {
  id           String            @id @default(uuid())
  type         ChatType
  title        String
  description  String?
  department   String?
  branchName   String?
  firmId       String?
  firm         Firm?             @relation(fields: [firmId], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type])
  @@index([firmId])
  @@index([updatedAt])
}

model ChatParticipant {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  mutedAt        DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id                  String            @id @default(uuid())
  conversationId      String
  conversation        ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId        String?
  sender              User?             @relation("ChatMessageSender", fields: [senderUserId], references: [id])
  kind                ChatMessageKind   @default(TEXT)
  content             String?
  attachment          Json?
  mentions            String[]          @default([])
  replyToMessageId    String?
  replyToMessage      ChatMessage?      @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id])
  replies             ChatMessage[]     @relation("ChatMessageReplies")
  forwardedFromId     String?
  forwardedFrom       ChatMessage?      @relation("ChatMessageForwards", fields: [forwardedFromId], references: [id])
  forwards            ChatMessage[]     @relation("ChatMessageForwards")
  editedAt            DateTime?
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([replyToMessageId])
  @@index([forwardedFromId])
}

model ChatFirmPermission {
  id              String   @id @default(uuid())
  firmAId         String
  firmBId         String
  enabled         Boolean  @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([firmAId, firmBId])
  @@index([enabled])
  @@index([firmAId])
  @@index([firmBId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Invitation {
  id        String    @id @default(uuid())
  email     String
  fullName  String?
  phone     String?
  firmId    String?
  firm      Firm?     @relation(fields: [firmId], references: [id])
  role      Role      @default(FIRM)
  firmRole  FirmUserRole @default(FIRM_ADMIN)
  token     String    @unique
  expiresAt DateTime
  subscriptionEndsAt DateTime?
  usedAt    DateTime?
  deletedAt DateTime?
  deletedByUserId String?
  deleteReason String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([firmId])
  @@index([createdBy])
  @@index([expiresAt])
  @@index([usedAt])
}

model Flight {
  id                       String                    @id @default(uuid())
  route                    String
  flightNumber             String
  airlineId                String?
  airline                  Airline?                  @relation(fields: [airlineId], references: [id])
  departure                DateTime                  @map("departureTime")
  arrival                  DateTime?                 @map("arrivalTime")
  currency                 String
  settlementStatus         FlightSettlementStatus    @default(OPEN)
  status                   String?
  deletedAt                DateTime?
  deletedByUserId          String?
  deleteReason             String?
  tickets                  Ticket[]
  tourPackages             TourPackage[]
  transactions             Transaction[]
  saleCancellationRequests SaleCancellationRequest[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([airlineId])
}

model Airline {
  id        String   @id @default(uuid())
  name      String
  code      String?
  firmId    String?
  firm      Firm?    @relation(fields: [firmId], references: [id])
  status    String   @default("ACTIVE")
  deletedAt DateTime?
  flights   Flight[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([firmId])
  @@index([status])
  @@index([deletedAt])
}

model Ticket {
  id                       String                    @id @default(uuid())
  flightId                 String
  flight                   Flight                    @relation(fields: [flightId], references: [id])
  status                   TicketStatus              @default(AVAILABLE)
  basePrice                Decimal                   @map("price") @db.Decimal(12, 4)
  currency                 String
  assignedFirmId           String?                   @map("allocatedFirmId")
  assignedFirm             Firm?                     @relation(fields: [assignedFirmId], references: [id])
  soldPrice                Decimal?                  @db.Decimal(12, 4)
  soldCurrency             String?
  purchaserInfo            Json?
  deletedAt                DateTime?
  deletedByUserId          String?
  deleteReason             String?
  saleCancellationRequests SaleCancellationRequest[]
  transactions             Transaction[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([flightId, status])
  @@index([assignedFirmId, status])
  @@index([flightId, assignedFirmId])
  @@index([deletedAt])
}

model CurrencyRate {
  id             String   @id @default(uuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(12, 6)
  source         String
  recordedAt     DateTime @default(now())
}

model SiteContent {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id              String          @id @default(uuid())
  type            TransactionType
  firmId          String
  firm            Firm            @relation(fields: [firmId], references: [id])
  kassaDeskId     String?
  kassaDesk       KassaDesk?      @relation(fields: [kassaDeskId], references: [id], onDelete: SetNull)
  flightId        String?
  flight          Flight?         @relation(fields: [flightId], references: [id])
  ticketId        String?
  ticket          Ticket?         @relation(fields: [ticketId], references: [id])
  payerFirmId     String?
  payerFirm       Firm?           @relation("TransactionPayerFirm", fields: [payerFirmId], references: [id])
  receiverFirmId  String?
  receiverFirm    Firm?           @relation("TransactionReceiverFirm", fields: [receiverFirmId], references: [id])
  direction       String?
  subjectType     String?
  subjectId       String?
  createdByUserId String?
  createdBy       User?           @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id])
  originalAmount  Decimal         @db.Decimal(12, 4)
  currency        String
  exchangeRate    Decimal         @db.Decimal(12, 6)
  baseAmount      Decimal         @db.Decimal(12, 4)
  paymentMethod   String?
  paymentCardId   String?
  paymentCard     PaymentCard?     @relation(fields: [paymentCardId], references: [id])
  idempotencyKey  String?         @unique
  metadata        Json?
  ledgerEntries   LedgerEntry[]
  paymentAllocations PaymentAllocation[]
  tourPackageSale TourPackageSale?
  createdAt       DateTime        @default(now())

  @@index([firmId, createdAt])
  @@index([kassaDeskId, createdAt])
  @@index([payerFirmId, createdAt])
  @@index([receiverFirmId, createdAt])
  @@index([flightId, createdAt])
  @@index([subjectType, subjectId])
  @@index([type, createdAt])
  @@index([currency, createdAt])
  @@index([paymentMethod, createdAt])
  @@index([paymentCardId, createdAt])
  @@index([createdByUserId, createdAt])
}

model PaymentAllocation {
  id              String      @id @default(uuid())
  companyId       String      @map("company_id")
  company         Firm        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentId       String      @map("payment_id")
  payment         Transaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  documentType    String      @map("document_type")
  documentId      String      @map("document_id")
  allocatedAmount Decimal     @map("allocated_amount") @db.Decimal(12, 4)
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([companyId])
  @@index([paymentId])
  @@index([documentType, documentId])
  @@map("payment_allocations")
}

model FinancialThreshold {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  company    Firm     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  metricCode String   @map("metric_code")
  greenMin   Decimal? @map("green_min") @db.Decimal(12, 4)
  yellowMin  Decimal? @map("yellow_min") @db.Decimal(12, 4)
  redMax     Decimal? @map("red_max") @db.Decimal(12, 4)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([companyId, metricCode])
  @@index([companyId])
  @@map("financial_thresholds")
}

model OverheadAllocationRule {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  company       Firm     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  method        String   @default("BY_REVENUE")
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([companyId, active])
  @@index([effectiveFrom, effectiveTo])
  @@map("overhead_allocation_rules")
}

model PaymentCard {
  id              String        @id @default(uuid())
  ownerName       String
  cardNumber      String
  currency        String        @default("UZS")
  openingBalance  Decimal       @default(0) @db.Decimal(12, 4)
  firmId          String?
  firm            Firm?         @relation(fields: [firmId], references: [id])
  status          String        @default("ACTIVE")
  deletedAt       DateTime?
  deletedByUserId String?
  deleteReason    String?
  createdByUserId String?
  createdBy       User?         @relation("PaymentCardCreatedBy", fields: [createdByUserId], references: [id])
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model KassaDesk {
  id              String      @id @default(uuid())
  firmId          String
  firm            Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name            String
  code            String?
  status          String      @default("ACTIVE")
  deletedAt       DateTime?
  deletedByUserId String?
  deleteReason    String?
  createdByUserId String?
  createdBy       User?       @relation("KassaDeskCreatedBy", fields: [createdByUserId], references: [id])
  transactions    Transaction[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([firmId, status])
  @@index([firmId, createdAt])
  @@index([firmId, name])
  @@index([deletedAt])
}

model TourPackage {
  id                String            @id @default(uuid())
  ownerFirmId       String
  ownerFirm         Firm              @relation("TourPackageOwner", fields: [ownerFirmId], references: [id])
  flightId          String?
  flight            Flight?           @relation(fields: [flightId], references: [id])
  name              String
  destination       String
  startDate         DateTime?
  endDate           DateTime?
  quantity          Int
  availableQuantity Int
  unitPrice         Decimal           @db.Decimal(12, 4)
  ticketPrice       Decimal           @default(0) @db.Decimal(12, 4)
  servicePrice      Decimal           @default(0) @db.Decimal(12, 4)
  currency          String            @default("UZS")
  status            String            @default("ACTIVE")
  deletedAt         DateTime?
  deletedByUserId   String?
  deleteReason      String?
  notes             String?
  sales             TourPackageSale[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([ownerFirmId, status])
  @@index([flightId, status])
  @@index([destination])
  @@index([deletedAt])
}

model TourPackageSale {
  id            String       @id @default(uuid())
  packageId     String
  package       TourPackage  @relation(fields: [packageId], references: [id])
  sellerFirmId  String
  sellerFirm    Firm         @relation("TourPackageSeller", fields: [sellerFirmId], references: [id])
  buyerFirmId   String
  buyerFirm     Firm         @relation("TourPackageBuyer", fields: [buyerFirmId], references: [id])
  quantity      Int
  unitPrice     Decimal      @db.Decimal(12, 4)
  currency      String
  totalAmount   Decimal      @db.Decimal(12, 4)
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([packageId, createdAt])
  @@index([sellerFirmId, createdAt])
  @@index([buyerFirmId, createdAt])
}

model LedgerEntry {
  id                   String      @id @default(uuid())
  transactionId        String
  transaction          Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  debitAccount         String
  creditAccount        String
  amount               Decimal     @db.Decimal(12, 4)
  currency             String
  exchangeRateSnapshot Decimal     @db.Decimal(12, 6)
  createdAt            DateTime    @default(now())

  @@index([transactionId])
  @@index([debitAccount])
  @@index([creditAccount])
  @@index([createdAt])
}

model Payment {
  id                   String               @id @default(uuid())
  firmId               String
  firm                 Firm                 @relation(fields: [firmId], references: [id])
  amount               Decimal              @db.Decimal(12, 4)
  method               PaymentMethod
  reference            String?
  status               PaymentStatus        @default(PENDING)
  reconciliationStatus ReconciliationStatus @default(PENDING)
  createdAt            DateTime             @default(now())

  @@index([firmId, status])
  @@index([reconciliationStatus])
  @@index([createdAt])
}

model KassaDay {
  id               String      @id @default(uuid())
  businessDate     DateTime    @db.Date
  status           KassaStatus @default(OPEN)
  openedAt         DateTime    @default(now())
  openedByUserId   String
  openedBy         User        @relation("KassaOpenedBy", fields: [openedByUserId], references: [id])
  closedAt         DateTime?
  closedByUserId   String?
  closedBy         User?       @relation("KassaClosedBy", fields: [closedByUserId], references: [id])
  openingBalance   Decimal     @default(0) @db.Decimal(12, 4)
  closingBalance   Decimal?    @db.Decimal(12, 4)
  expectedCash     Decimal?    @db.Decimal(12, 4)
  variance         Decimal?    @db.Decimal(12, 4)
  notes            String?

  @@unique([businessDate])
  @@index([status])
  @@index([businessDate, status])
}

model SaleCancellationRequest {
  id              String    @id @default(uuid())
  flightId        String
  flight          Flight    @relation(fields: [flightId], references: [id])
  ticketId        String
  ticket          Ticket    @relation(fields: [ticketId], references: [id])
  firmId          String
  firm            Firm      @relation(fields: [firmId], references: [id])
  status          String    @default("PENDING")
  reason          String
  decisionReason  String?
  createdByUserId String
  createdBy       User      @relation("SaleCancellationRequestCreatedBy", fields: [createdByUserId], references: [id])
  decidedByUserId String?
  decidedBy       User?     @relation("SaleCancellationRequestDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([flightId, status])
  @@index([ticketId, status])
  @@index([firmId, status])
  @@index([createdByUserId])
  @@index([decidedByUserId])
}
