  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  products        Product[]

  @@unique([firmId, code])
  @@index([firmId, parentId, isActive])
  @@index([deletedAt])
}

model InventoryUnit {
  id               String    @id @default(uuid())
  firmId           String
  firm             Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  code             String
  name             String
  baseUnitId       String?
  conversionToBase Decimal?  @db.Decimal(18, 6)
  isSystemDefault  Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdByUserId  String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]

  @@unique([firmId, code])
  @@index([firmId, isActive])
}

model InventorySupplier {
  id              String              @id @default(uuid())
  firmId          String
  firm            Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name            String
  taxId           String?
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  paymentTerms    String?
  defaultCurrency String              @default("UZS")
  creditLimit     Decimal             @default(0) @db.Decimal(18, 4)
  status          String              @default("ACTIVE")
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  products        Product[]
  batches         InventoryBatch[]
  documents       InventoryDocument[]

  @@index([firmId, status])
  @@index([firmId, name])
  @@index([deletedAt])
}

model InventoryCustomer {
  id                String              @id @default(uuid())
  firmId            String
  firm              Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name              String
  type              String              @default("BUSINESS")
  phone             String?
  email             String?
  address           String?
  responsiblePerson String?
  creditLimit       Decimal             @default(0) @db.Decimal(18, 4)
  paymentTerms      String?
  status            String              @default("ACTIVE")
  notes             String?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  documents         InventoryDocument[]

  @@index([firmId, status])
  @@index([firmId, name])
  @@index([deletedAt])
}

model Warehouse {
  id                String                 @id @default(uuid())
  firmId            String
  firm              Firm                   @relation("WarehouseFirm", fields: [firmId], references: [id], onDelete: Cascade)
  branchId          String?
  name              String
  code              String
  address           String?
  responsibleUserId String?
  status            String                 @default("ACTIVE")
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  products          Product[]              @relation("ProductDefaultWarehouse")
  batches           InventoryBatch[]
  sourceDocuments   InventoryDocument[]    @relation("InventoryDocumentWarehouse")
  targetDocuments   InventoryDocument[]    @relation("InventoryDocumentDestination")
  sourceMovements   InventoryMovement[]    @relation("InventoryMovementWarehouse")
  targetMovements   InventoryMovement[]    @relation("InventoryMovementDestination")
  reservations      InventoryReservation[]

  @@unique([firmId, code])
  @@index([firmId, status])
  @@index([deletedAt])
}

model Product {
  id                   String                  @id @default(uuid())
  firmId               String
  firm                 Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  sku                  String
  barcode              String?
  name                 String
  description          String?
  categoryId           String
  category             InventoryCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unitId               String
  unit                 InventoryUnit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  minimumStock         Decimal                 @default(0) @db.Decimal(18, 4)
  reorderPoint         Decimal                 @default(0) @db.Decimal(18, 4)
  defaultPurchasePrice Decimal?                @db.Decimal(18, 4)
  defaultSalePrice     Decimal?                @db.Decimal(18, 4)
  currency             String                  @default("UZS")
  defaultSupplierId    String?
  defaultSupplier      InventorySupplier?      @relation(fields: [defaultSupplierId], references: [id], onDelete: SetNull)
  defaultWarehouseId   String?
  defaultWarehouse     Warehouse?              @relation("ProductDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  tracksBatch          Boolean                 @default(false)
  tracksExpiry         Boolean                 @default(false)
  status               String                  @default("ACTIVE")
  createdByUserId      String?
  updatedByUserId      String?
  deletedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  batches              InventoryBatch[]
  documentLines        InventoryDocumentLine[]
  movements            InventoryMovement[]
  reservations         InventoryReservation[]

  @@unique([firmId, sku])
  @@unique([firmId, barcode])
  @@index([firmId, name])
  @@index([firmId, status])
  @@index([deletedAt])
}

model InventoryBatch {
  id                   String                  @id @default(uuid())
  firmId               String
  firm                 Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  warehouseId          String
  warehouse            Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId            String
  product              Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchNumber          String
  manufactureDate      DateTime?
  expiryDate           DateTime?
  receivedQuantity     Decimal                 @default(0) @db.Decimal(18, 4)
  reservedQuantity     Decimal                 @default(0) @db.Decimal(18, 4)
  issuedQuantity       Decimal                 @default(0) @db.Decimal(18, 4)
  unitCost             Decimal                 @db.Decimal(18, 4)
  currency             String                  @default("UZS")
  exchangeRateSnapshot Decimal                 @default(1) @db.Decimal(18, 6)
  status               String                  @default("ACTIVE")
  supplierId           String?
  supplier             InventorySupplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sourceDocumentId     String?
  sourceDocument       InventoryDocument?      @relation("InventoryBatchSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  documentLines        InventoryDocumentLine[]
  movements            InventoryMovement[]
  reservations         InventoryReservation[]

  @@unique([warehouseId, productId, batchNumber])
  @@index([firmId, productId, expiryDate])
  @@index([warehouseId, productId, status])
}

model InventoryDocument {
  id                     String                  @id @default(uuid())
  firmId                 String
  firm                   Firm                    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  type                   InventoryDocumentType
  status                 InventoryDocumentStatus @default(DRAFT)
  documentNumber         String
  documentDate           DateTime
  warehouseId            String
  warehouse              Warehouse               @relation("InventoryDocumentWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?              @relation("InventoryDocumentDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  supplierId             String?
  supplier               InventorySupplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customerId             String?
  customer               InventoryCustomer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentStatus          String?
  paymentSourceAccountId String?
  currency               String                  @default("UZS")
  exchangeRateSnapshot   Decimal                 @default(1) @db.Decimal(18, 6)
  grossAmount            Decimal                 @default(0) @db.Decimal(18, 4)
  discountAmount         Decimal                 @default(0) @db.Decimal(18, 4)
  netAmount              Decimal                 @default(0) @db.Decimal(18, 4)
  vatAmount              Decimal                 @default(0) @db.Decimal(18, 4)
  contractNumber         String?
  invoiceNumber          String?
  flightId               String?
  tourPackageId          String?
  costCenterId           String?
  employeeId             String?
  notes                  String?
  attachment             Json?
  createdByUserId        String?
  approvedByUserId       String?
  appliedAt              DateTime?
  reversedDocumentId     String?
  deletedAt              DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lines                  InventoryDocumentLine[]
  movements              InventoryMovement[]
  sourcedBatches         InventoryBatch[]        @relation("InventoryBatchSourceDocument")

  @@unique([firmId, documentNumber])
  @@index([firmId, type, status, documentDate])
  @@index([warehouseId, documentDate])
  @@index([deletedAt])
}

model InventoryDocumentLine {
  id               String              @id @default(uuid())
  documentId       String
  document         InventoryDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId          String?
  batch            InventoryBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchNumber      String?
  manufactureDate  DateTime?
  expiryDate       DateTime?
  quantity         Decimal             @db.Decimal(18, 4)
  unitPrice        Decimal             @db.Decimal(18, 4)
  unitCostSnapshot Decimal             @db.Decimal(18, 4)
  lineTotal        Decimal             @db.Decimal(18, 4)
  baseLineTotal    Decimal             @db.Decimal(18, 4)
  discountAmount   Decimal             @default(0) @db.Decimal(18, 4)
  createdAt        DateTime            @default(now())
  movements        InventoryMovement[]

  @@index([documentId])
  @@index([productId, batchId])
}

model InventoryMovement {
  id                     String                 @id @default(uuid())
  firmId                 String
  firm                   Firm                   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  warehouseId            String
  warehouse              Warehouse              @relation("InventoryMovementWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  destinationWarehouseId String?
  destinationWarehouse   Warehouse?             @relation("InventoryMovementDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  productId              String
  product                Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId                String?
  batch                  InventoryBatch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  documentId             String?
  document               InventoryDocument?     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentLineId         String?
  documentLine           InventoryDocumentLine? @relation(fields: [documentLineId], references: [id], onDelete: Restrict)
  movementType           InventoryMovementType
  quantity               Decimal                @db.Decimal(18, 4)
  unitCostSnapshot       Decimal                @db.Decimal(18, 4)
  totalCostSnapshot      Decimal                @db.Decimal(18, 4)
  currency               String                 @default("UZS")
  exchangeRateSnapshot   Decimal                @default(1) @db.Decimal(18, 6)
  sourceType             String?
  sourceReferenceId      String?
  documentNumber         String?
  movementDate           DateTime
  status                 String                 @default("APPLIED")
  createdByUserId        String?
  approvedByUserId       String?
  reversedMovementId     String?
  transactionId          String?                @unique
  transaction            Transaction?           @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  deletedAt              DateTime?
  createdAt              DateTime               @default(now())

  @@index([firmId, movementDate])
  @@index([warehouseId, productId, batchId, status])
  @@index([sourceType, sourceReferenceId])
  @@index([reversedMovementId])
  @@index([deletedAt])
}

model InventoryReservation {
  id                String                     @id @default(uuid())
  firmId            String
  firm              Firm                       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId         String
  product           Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId           String?
  batch             InventoryBatch?            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sourceType        String
  sourceReferenceId String
  quantity          Decimal                    @db.Decimal(18, 4)
  consumedQuantity  Decimal                    @default(0) @db.Decimal(18, 4)
  status            InventoryReservationStatus @default(RESERVED)
  expiresAt         DateTime?
  createdByUserId   String?
  releasedByUserId  String?
  releaseReason     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([firmId, sourceType, sourceReferenceId])
  @@index([warehouseId, productId, status])
}

model Payment {
  id                   String               @id @default(uuid())
  firmId               String
  firm                 Firm                 @relation(fields: [firmId], references: [id])
  amount               Decimal              @db.Decimal(18, 4)
  method               PaymentMethod
  reference            String?
  status               PaymentStatus        @default(PENDING)
  reconciliationStatus ReconciliationStatus @default(PENDING)
  createdAt            DateTime             @default(now())

  @@index([firmId, status])
  @@index([reconciliationStatus])
  @@index([createdAt])
}

model KassaDay {
  id                      String      @id @default(uuid())
  firmId                  String
  cashDeskId              String
  cashDesk                KassaDesk   @relation(fields: [cashDeskId, firmId], references: [id, firmId], onDelete: Restrict)
  activeSessionKey        String?     @unique
  currency                String      @default("UZS")
  previousSessionId       String?     @unique
  previousSession         KassaDay?   @relation("KassaSessionChain", fields: [previousSessionId], references: [id], onDelete: SetNull)
  nextSession             KassaDay?   @relation("KassaSessionChain")
  businessDate            DateTime    @db.Date
  status                  KassaStatus @default(OPEN)
  openedAt                DateTime    @default(now())
  openedByUserId          String
  openedBy                User        @relation("KassaOpenedBy", fields: [openedByUserId], references: [id])
  closedAt                DateTime?
  closedByUserId          String?
  closedBy                User?       @relation("KassaClosedBy", fields: [closedByUserId], references: [id])
  openingBalance          Decimal     @default(0) @db.Decimal(18, 4)
  openingBalanceUsd       Decimal     @default(0) @db.Decimal(18, 4)
  closingBalance          Decimal?    @db.Decimal(18, 4)
  closingBalanceUsd       Decimal?    @db.Decimal(18, 4)
  actualClosingBalance    Decimal?    @db.Decimal(18, 4)
  actualClosingBalanceUsd Decimal?    @db.Decimal(18, 4)
  expectedCash            Decimal?    @db.Decimal(18, 4)
  expectedCashUsd         Decimal?    @db.Decimal(18, 4)
  variance                Decimal?    @db.Decimal(18, 4)
  varianceUsd             Decimal?    @db.Decimal(18, 4)
  openingAdjustmentReason String?
  notes                   String?

  @@unique([businessDate, cashDeskId])
  @@index([cashDeskId, status, closedAt])
  @@index([firmId, cashDeskId, currency, status, closedAt])
  @@index([status])
  @@index([businessDate, status])
}

model SaleCancellationRequest {
  id              String      @id @default(uuid())
  flightId        String
  flight          Flight      @relation(fields: [flightId], references: [id])
  ticketId        String
  ticket          Ticket      @relation(fields: [ticketId], references: [id])
  ticketSaleId    String?
  ticketSale      TicketSale? @relation(fields: [ticketSaleId], references: [id], onDelete: Restrict)
  firmId          String
  firm            Firm        @relation(fields: [firmId], references: [id])
  status          String      @default("PENDING")
  reason          String
  decisionReason  String?
  createdByUserId String
  createdBy       User        @relation("SaleCancellationRequestCreatedBy", fields: [createdByUserId], references: [id])
  decidedByUserId String?
  decidedBy       User?       @relation("SaleCancellationRequestDecidedBy", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([flightId, status])
  @@index([ticketId, status])
  @@index([ticketSaleId, status])
  @@index([firmId, status])
  @@index([createdByUserId])
  @@index([decidedByUserId])
}
