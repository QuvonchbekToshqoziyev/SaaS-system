datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  ADMIN
  FIRM
}

enum FirmUserRole {
  FIRM_ADMIN
  MANAGER
  KASSIR
  OMBOR_MUDIRI
}

enum FlightSettlementStatus {
  OPEN
  CLOSING
  CLOSED
}

enum TicketStatus {
  AVAILABLE
  PENDING
  ASSIGNED
  ALLOCATED
  RESERVED_FOR_TOUR
  SOLD
  CANCELLED
  REFUNDED
  DELETED
}

enum TicketProductType {
  ROUND_TRIP
  ONE_WAY
}

enum TicketLegDirection {
  OUTBOUND
  RETURN
}

enum TicketLegStatus {
  AVAILABLE
  PENDING_ALLOCATION
  ASSIGNED
  RESERVED_FOR_TOUR
  SOLD
  CANCELLED
  RETURNED
  DELETED
}

enum FirmStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FirmKind {
  AGENCY
  AIRLINE
  CONTRACTOR
}

enum TransactionType {
  ALLOCATION
  SALE
  PAYMENT
  REFUND
  ADJUSTMENT
  PAYABLE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ReconciliationStatus {
  PENDING
  MATCHED
  FAILED
}

enum KassaStatus {
  OPEN
  CLOSED
}

enum FinancialAccountType {
  CASH
  CARD
  BANK
  OWNER
  OTHER
  BANK_ACCOUNT
  CASH_DESK
  PAYMENT_CARD
  RECEIVABLE_ACCOUNT
  PAYABLE_ACCOUNT
  FOUNDER_ACCOUNT
  ADVANCE_ACCOUNT
  CLEARING_ACCOUNT
  OTHER_ACCOUNT
}

enum InventoryDocumentType {
  PURCHASE
  CUSTOMER_RETURN
  INTERNAL_RECEIPT
  FOUNDER_CONTRIBUTION
  INVENTORY_SURPLUS
  PRODUCTION_RECEIPT
  FREE_RECEIPT
  SALE
  INTERNAL_USE
  TRANSFER
  WRITE_OFF
  SUPPLIER_RETURN
  EMPLOYEE_ISSUE
  FREE_ISSUE
  INVENTORY_SHORTAGE
  OTHER_RECEIPT
  OTHER_ISSUE
}

enum InventoryDocumentStatus {
  DRAFT
  SENT
  IN_TRANSIT
  APPLIED
  RECEIVED
  REJECTED
  CANCELLED
  REVERSED
}

enum InventoryMovementType {
  PURCHASE_IN
  SALE_OUT
  CUSTOMER_RETURN_IN
  SUPPLIER_RETURN_OUT
  INTERNAL_USE_OUT
  TRANSFER_OUT
  TRANSFER_IN
  WRITE_OFF_OUT
  INVENTORY_SURPLUS_IN
  INVENTORY_SHORTAGE_OUT
  PRODUCTION_IN
  FREE_RECEIPT_IN
  EMPLOYEE_ISSUE_OUT
  FREE_ISSUE_OUT
  OTHER_IN
  OTHER_OUT
}

enum InventoryReservationStatus {
  RESERVED
  PARTIALLY_CONSUMED
  CONSUMED
  RELEASED
  CANCELLED
}

enum ChatType {
  PERSONAL
  DEPARTMENT
  BRANCH
  COMPANY
  SUPPORT
  AI
}

enum ChatMessageKind {
  TEXT
  EMOJI
  FILE
  IMAGE
  PDF
  EXCEL
  VOICE
}

model User {
  id                              String                    @id @default(uuid())
  email                           String                    @unique
  password                        String
  fullName                        String?
  phone                           String?
  role                            Role                      @default(FIRM)
  readOnlyAccess                  Boolean                   @default(false)
  firmRole                        FirmUserRole              @default(MANAGER)
  status                          String                    @default("ACTIVE")
  firmId                          String?
  firm                            Firm?                     @relation(fields: [firmId], references: [id])
  firmAccesses                    UserFirmAccess[]
  createdTransactions             Transaction[]             @relation("TransactionCreatedBy")
  createdKassaDesks               KassaDesk[]               @relation("KassaDeskCreatedBy")
  assignedKassaDesks              KassaDesk[]               @relation("KassaDeskCashier")
  createdSaleCancellationRequests SaleCancellationRequest[] @relation("SaleCancellationRequestCreatedBy")
  decidedSaleCancellationRequests SaleCancellationRequest[] @relation("SaleCancellationRequestDecidedBy")
  openedKassaDays                 KassaDay[]                @relation("KassaOpenedBy")
  closedKassaDays                 KassaDay[]                @relation("KassaClosedBy")
  createdPaymentCards             PaymentCard[]             @relation("PaymentCardCreatedBy")
  chatParticipants                ChatParticipant[]
  sentChatMessages                ChatMessage[]             @relation("ChatMessageSender")
  createdServiceOfferings         ServiceOffering[]         @relation("ServiceOfferingCreator")
  createdTourPackages             TourPackage[]             @relation("TourPackageCreator")
  deletedTourPackages             TourPackage[]             @relation("TourPackageDeletedBy")
  auditLogs                       AuditLog[]                @relation("AuditLogActor")
  notifications                   Notification[]            @relation("NotificationUser")
  telegramChatId                  String?                   @unique
  telegramUsername                String?
  telegramNotificationsEnabled    Boolean                   @default(true)
  telegramLinkedAt                DateTime?
  telegramLinkTokenHash           String?                   @unique
  telegramLinkExpiresAt           DateTime?
  telegramDeliveries              TelegramDelivery[]
  createdCurrencyRates            CurrencyRate[]            @relation("CurrencyRateCreatedBy")
  createdTicketSales              TicketSale[]              @relation("TicketSaleCreatedBy")
  createdExpenseCategories        ExpenseCategory[]         @relation("ExpenseCategoryCreatedBy")
  updatedExpenseCategories        ExpenseCategory[]         @relation("ExpenseCategoryUpdatedBy")
  postedJournalEntries            JournalEntry[]            @relation("JournalEntryPostedBy")
  deletedAt                       DateTime?
  deletedByUserId                 String?
  deleteReason                    String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt

  @@index([status])
  @@index([firmRole])
  @@index([deletedAt])
}

model Firm {
  id                        String                    @id @default(uuid())
  name                      String
  contactFullName           String?
  phone                     String?
  subscriptionEndsAt        DateTime?
  creditLimit               Decimal                   @default(0) @db.Decimal(18, 4)
  currency                  String                    @default("USD")
  accountingFramework       String                    @default("MANAGEMENT_ONLY")
  accountingPolicyVersion   String                    @default("1")
  inventoryValuationMethod  String                    @default("MOVING_WEIGHTED_AVERAGE")
  chartOfAccountsVersion    String                    @default("1")
  reportingStartDate        DateTime?
  fiscalYearStart           Int                       @default(1)
  timezone                  String                    @default("Asia/Tashkent")
  kind                      FirmKind                  @default(AGENCY)
  status                    FirmStatus                @default(ACTIVE)
  deletedAt                 DateTime?
  deletedByUserId           String?
  deleteReason              String?
  createdByUserId           String?
  createdByFirmId           String?
  createdByRole             String?
  users                     User[]
  userAccesses              UserFirmAccess[]
  employees                 Employee[]
  tickets                   Ticket[]                  @relation("TicketAssignedFirm")
  originalTickets           Ticket[]                  @relation("TicketOriginalOwnerFirm")
  ownedTicketLegs           TicketLeg[]               @relation("TicketLegCurrentOwnerFirm")
  allocationSourceTickets   Ticket[]                  @relation("TicketAllocationSourceFirm")
  sentTicketAllocations     TicketAllocation[]        @relation("TicketAllocationSender")
  receivedTicketAllocations TicketAllocation[]        @relation("TicketAllocationReceiver")
  ownedFlights              Flight[]                  @relation("FlightOwnerFirm")
  transactions              Transaction[]
  kassaDesks                KassaDesk[]
  paidTransactions          Transaction[]             @relation("TransactionPayerFirm")
  receivedTransactions      Transaction[]             @relation("TransactionReceiverFirm")
  payments                  Payment[]
  paymentCards              PaymentCard[]
  paymentAllocations        PaymentAllocation[]
  currencyRates             CurrencyRate[]
  financialAccounts         FinancialAccount[]
  financialThresholds       FinancialThreshold[]
  overheadAllocationRules   OverheadAllocationRule[]
  expenseCategories         ExpenseCategory[]
  expenseBudgets            ExpenseBudget[]
  expenseApprovalRules      ExpenseApprovalRule[]
  costCenters               CostCenter[]
  journalEntries            JournalEntry[]
  invitations               Invitation[]
  saleCancellationRequests  SaleCancellationRequest[]
  ticketSales               TicketSale[]              @relation("TicketSaleSellerFirm")
  ownedTourPackages         TourPackage[]             @relation("TourPackageOwner")
  boughtTourPackageSales    TourPackageSale[]         @relation("TourPackageBuyer")
  soldTourPackageSales      TourPackageSale[]         @relation("TourPackageSeller")
  ownedServiceOfferings     ServiceOffering[]         @relation("ServiceOfferingOwner")
  suppliedServiceOfferings  ServiceOffering[]         @relation("ServiceOfferingProvider")
  providedServices          ServiceAssignment[]       @relation("ServiceProviderFirm")
  receivedServices          ServiceAssignment[]       @relation("ServiceRecipientFirm")
  chatConversations         ChatConversation[]
  airlineProfiles           Airline[]
  notifications             Notification[]
  airlineConnections        AirlineFirmConnection[]   @relation("AirlineConnectionAirline")
  firmAirlineConnections    AirlineFirmConnection[]   @relation("AirlineConnectionFirm")
  inventoryCategories       InventoryCategory[]
  inventoryUnits            InventoryUnit[]
  suppliers                 InventorySupplier[]
  inventoryCustomers        InventoryCustomer[]
  warehouses                Warehouse[]               @relation("WarehouseFirm")
  products                  Product[]
  inventoryBatches          InventoryBatch[]
  inventoryDocuments        InventoryDocument[]
  inventoryMovements        InventoryMovement[]
  inventoryReservations     InventoryReservation[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([kind])
  @@index([createdByUserId])
  @@index([createdByFirmId])
  @@index([status])
  @@index([deletedAt])
}

model Notification {
  id                 String             @id @default(uuid())
  firmId             String?
  firm               Firm?              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?              @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  title              String
  body               String
  type               String             @default("INFO")
  entityType         String?
  entityId           String?
  metadata           Json?
  readAt             DateTime?
  createdAt          DateTime           @default(now())
  telegramDeliveries TelegramDelivery[]

  @@index([firmId, readAt, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model TelegramDelivery {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId         String
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([notificationId, userId])
  @@index([status, createdAt])
}

model AirlineFirmConnection {
  id              String   @id @default(uuid())
  airlineFirmId   String
  airlineFirm     Firm     @relation("AirlineConnectionAirline", fields: [airlineFirmId], references: [id], onDelete: Cascade)
  firmId          String
  firm            Firm     @relation("AirlineConnectionFirm", fields: [firmId], references: [id], onDelete: Cascade)
  status          String   @default("ACTIVE")
  createdByUserId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([airlineFirmId, firmId])
  @@index([airlineFirmId, status])
  @@index([firmId, status])
}

model UserFirmAccess {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, firmId])
  @@index([userId])
  @@index([firmId])
}

model Employee {
  id              String     @id @default(uuid())
  name            String
  role            String
  salary          Decimal    @default(0) @db.Decimal(18, 4)
  currency        String     @default("UZS")
  firmId          String?
  firm            Firm?      @relation(fields: [firmId], references: [id])
  status          FirmStatus @default(ACTIVE)
  deletedAt       DateTime?
  deletedByUserId String?
  deleteReason    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([firmId])
  @@index([status])
  @@index([deletedAt])
}

model ChatConversation {
  id           String            @id @default(uuid())
  type         ChatType
  title        String
  description  String?
  department   String?
  branchName   String?
  firmId       String?
  firm         Firm?             @relation(fields: [firmId], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type])
  @@index([firmId])
  @@index([updatedAt])
}

model ChatParticipant {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  mutedAt        DateTime?
  joinedAt       DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id               String           @id @default(uuid())
  conversationId   String
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId     String?
  sender           User?            @relation("ChatMessageSender", fields: [senderUserId], references: [id])
  kind             ChatMessageKind  @default(TEXT)
  content          String?
  attachment       Json?
  mentions         String[]         @default([])
  replyToMessageId String?
  replyToMessage   ChatMessage?     @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id])
  replies          ChatMessage[]    @relation("ChatMessageReplies")
  forwardedFromId  String?
  forwardedFrom    ChatMessage?     @relation("ChatMessageForwards", fields: [forwardedFromId], references: [id])
  forwards         ChatMessage[]    @relation("ChatMessageForwards")
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([replyToMessageId])
  @@index([forwardedFromId])
}

model ChatFirmPermission {
  id              String   @id @default(uuid())
  firmAId         String
  firmBId         String
  enabled         Boolean  @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([firmAId, firmBId])
  @@index([enabled])
  @@index([firmAId])
  @@index([firmBId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model FeatureUsageMonthly {
  id          String   @id @default(uuid())
  month       DateTime
  featureKey  String
  featureLabel String
  action      String
  firmId      String   @default("")
  actorUserId String   @default("")
  actorRole   String   @default("")
  count       Int      @default(0)
  firstUsedAt DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, featureKey, action, firmId, actorUserId, actorRole])
  @@index([month, featureKey])
  @@index([firmId, month])
  @@index([actorUserId, month])
}

model Invitation {
  id                 String       @id @default(uuid())
  email              String
  fullName           String?
  phone              String?
  firmId             String?
  firm               Firm?        @relation(fields: [firmId], references: [id])
  role               Role         @default(FIRM)
  firmRole           FirmUserRole @default(MANAGER)
  token              String       @unique
  expiresAt          DateTime
  subscriptionEndsAt DateTime?
  usedAt             DateTime?
  deletedAt          DateTime?
  deletedByUserId    String?
  deleteReason       String?
  createdBy          String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([firmId])
  @@index([createdBy])
  @@index([expiresAt])
  @@index([usedAt])
}

model Flight {
  id                       String                    @id @default(uuid())
  route                    String
  flightNumber             String
  airlineId                String?
  airline                  Airline?                  @relation(fields: [airlineId], references: [id])
  ownerFirmId              String?
  ownerFirm                Firm?                     @relation("FlightOwnerFirm", fields: [ownerFirmId], references: [id], onDelete: Restrict)
  departure                DateTime                  @map("departureTime")
  arrival                  DateTime?                 @map("arrivalTime")
  tripType                 TicketProductType         @default(ONE_WAY)
  outboundOrigin           String?
  outboundDestination      String?
  returnOrigin             String?
  returnDestination        String?
  returnDeparture          DateTime?
  returnArrival            DateTime?
  currency                 String
  settlementStatus         FlightSettlementStatus    @default(OPEN)
  status                   String?
  deletedAt                DateTime?
  deletedByUserId          String?
  deleteReason             String?
  tickets                  Ticket[]
  ticketAllocations        TicketAllocation[]
  tourPackages             TourPackage[]
  serviceOfferings         ServiceOffering[]
  transactions             Transaction[]
  saleCancellationRequests SaleCancellationRequest[]
  ticketSales              TicketSale[]
  ticketLegMigrationIssues TicketLegMigrationIssue[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  ticketLegs               TicketLeg[]

  @@index([airlineId])
  @@index([ownerFirmId])
}

model Airline {
  id        String    @id @default(uuid())
  name      String
  code      String?
  firmId    String?
  firm      Firm?     @relation(fields: [firmId], references: [id])
  status    String    @default("ACTIVE")
  deletedAt DateTime?
  flights   Flight[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name])
  @@index([firmId])
  @@index([status])
  @@index([deletedAt])
}

model Ticket {
  id                       String                    @id @default(uuid())
  flightId                 String
  flight                   Flight                    @relation(fields: [flightId], references: [id])
  status                   TicketStatus              @default(AVAILABLE)
  ticketType               TicketProductType         @default(ONE_WAY)
  basePrice                Decimal                   @map("price") @db.Decimal(18, 4)
  originPrice              Decimal                   @default(0) @db.Decimal(18, 4)
  currency                 String
  assignedFirmId           String?                   @map("allocatedFirmId")
  assignedFirm             Firm?                     @relation("TicketAssignedFirm", fields: [assignedFirmId], references: [id])
  originalOwnerFirmId      String?
  originalOwnerFirm        Firm?                     @relation("TicketOriginalOwnerFirm", fields: [originalOwnerFirmId], references: [id], onDelete: Restrict)
  allocationSourceFirmId   String?
  allocationSourceFirm     Firm?                     @relation("TicketAllocationSourceFirm", fields: [allocationSourceFirmId], references: [id], onDelete: Restrict)
  allocationSourcePrice    Decimal?                  @db.Decimal(18, 4)
  allocationId             String?
  allocation               TicketAllocation?         @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  tourPackageId            String?
  tourPackage              TourPackage?              @relation(fields: [tourPackageId], references: [id], onDelete: Restrict)
  soldPrice                Decimal?                  @db.Decimal(18, 4)
  soldCurrency             String?
  purchaserInfo            Json?
  deletedAt                DateTime?
  deletedByUserId          String?
  deleteReason             String?
  saleCancellationRequests SaleCancellationRequest[]
  transactions             Transaction[]
  legs                     TicketLeg[]
  migrationIssues          TicketLegMigrationIssue[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([flightId, status])
  @@index([assignedFirmId, status])
  @@index([originalOwnerFirmId, status])
  @@index([allocationSourceFirmId, status])
  @@index([allocationId, status])
  @@index([flightId, assignedFirmId])
  @@index([tourPackageId, status])
  @@index([deletedAt])
}

model TicketLeg {
  id                      String                @id @default(uuid())
  ticketId                String
  ticket                  Ticket                @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  flightId                String
  flight                  Flight                @relation(fields: [flightId], references: [id], onDelete: Restrict)
  direction               TicketLegDirection
  origin                  String
  destination             String
  departureAt             DateTime?
  arrivalAt               DateTime?
  status                  TicketLegStatus       @default(AVAILABLE)
  currentOwnerFirmId      String?
  currentOwnerFirm        Firm?                 @relation("TicketLegCurrentOwnerFirm", fields: [currentOwnerFirmId], references: [id], onDelete: Restrict)
  pendingAllocationId     String?
  pendingAllocation       TicketAllocation?     @relation("PendingAllocationLegs", fields: [pendingAllocationId], references: [id], onDelete: SetNull)
  acceptedAllocationId    String?
  acceptedAllocation      TicketAllocation?     @relation("AcceptedAllocationLegs", fields: [acceptedAllocationId], references: [id], onDelete: SetNull)
  tourPackageId           String?
  tourPackage             TourPackage?          @relation(fields: [tourPackageId], references: [id], onDelete: Restrict)
  acquisitionCostSnapshot Decimal               @db.Decimal(18, 4)
  originalCostSnapshot    Decimal               @db.Decimal(18, 4)
  allocationPriceSnapshot Decimal?              @db.Decimal(18, 4)
  currencySnapshot        String
  allocationItems         TicketAllocationLeg[]
  saleItems               TicketSaleItem[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([ticketId, direction])
  @@index([flightId, currentOwnerFirmId, status, direction])
  @@index([pendingAllocationId, status])
  @@index([acceptedAllocationId, status])
  @@index([tourPackageId, status])
}

model TicketAllocation {
  id                String                     @id @default(uuid())
  flightId          String
  flight            Flight                     @relation(fields: [flightId], references: [id], onDelete: Restrict)
  fromFirmId        String
  fromFirm          Firm                       @relation("TicketAllocationSender", fields: [fromFirmId], references: [id], onDelete: Restrict)
  toFirmId          String
  toFirm            Firm                       @relation("TicketAllocationReceiver", fields: [toFirmId], references: [id], onDelete: Restrict)
  status            String                     @default("PENDING")
  currency          String
  totalAmount       Decimal                    @db.Decimal(18, 4)
  note              String?
  createdByUserId   String?
  acceptedAt        DateTime?
  acceptedByUserId  String?
  rejectionReason   String?
  rejectedAt        DateTime?
  rejectedByUserId  String?
  cancelledAt       DateTime?
  cancelledByUserId String?
  version           Int                        @default(1)
  productType       TicketProductType          @default(ROUND_TRIP)
  direction         TicketLegDirection?
  parentTicketCount Int                        @default(0)
  segmentCount      Int                        @default(0)
  tickets           Ticket[]
  priceRows         TicketAllocationPriceRow[]
  legItems          TicketAllocationLeg[]
  pendingLegs       TicketLeg[]                @relation("PendingAllocationLegs")
  acceptedLegs      TicketLeg[]                @relation("AcceptedAllocationLegs")
  changeRequests    AllocationChangeRequest[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([flightId, status])
  @@index([fromFirmId, status])
  @@index([toFirmId, status])
  @@index([createdAt])
}

model AllocationChangeRequest {
  id                           String           @id @default(uuid())
  allocationId                 String
  allocation                   TicketAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  requestedByFirmId            String
  requestedByUserId            String?
  receivingFirmId              String
  type                         String
  oldValuesJson                Json
  proposedValuesJson           Json
  reason                       String
  status                       String           @default("PENDING_APPROVAL")
  requiresCounterpartyApproval Boolean          @default(true)
  autoApproved                 Boolean          @default(false)
  baseVersion                  Int
  approvedByUserId             String?
  rejectedByUserId             String?
  rejectionReason              String?
  approvedAt                   DateTime?
  rejectedAt                   DateTime?
  appliedAt                    DateTime?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([allocationId, status])
  @@index([requestedByFirmId, status])
  @@index([receivingFirmId, status])
  @@index([createdAt])
}

model TicketAllocationPriceRow {
  id           String              @id @default(uuid())
  allocationId String
  allocation   TicketAllocation    @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  quantity     Int
  unitPrice    Decimal             @db.Decimal(18, 4)
  position     Int                 @default(0)
  productType  TicketProductType   @default(ROUND_TRIP)
  direction    TicketLegDirection?
  currency     String              @default("UZS")
  totalAmount  Decimal             @default(0) @db.Decimal(18, 4)

